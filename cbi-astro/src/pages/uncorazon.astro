---
import Layout from "@/layouts/Layout.astro"
import UnCorazonHero from "@/components/uncorazon/UnCorazonHero.astro"
import UnCorazonVision from "@/components/uncorazon/UnCorazonVision.astro"
import UnCorazonGoals from "@/components/uncorazon/UnCorazonGoals.astro"
import UnCorazonFAQ from "@/components/uncorazon/UnCorazonFAQ.astro"
import UnCorazonParticipate from "@/components/uncorazon/UnCorazonParticipate.astro"
import ogImage from "@/assets/og-uncorazon.jpg"
import { uncorazonFaqs } from "@/helpers/uncorazonFAQ.js"
import { phone, email } from "@/constants.js"

const title = "Un Corazón Para Su Casa | Campaña de CBI Orlando"
const description =
	"Un Corazón para Su Casa es la campaña de generosidad de CBI Orlando para adquirir un edificio propio para la iglesia y Murphy Christian Academy. Conoce la visión, las metas y cómo participar."
const pageURL = new URL("/uncorazon", Astro.site).href

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Church",
			"@id": `${Astro.site}#church`,
			name: "CBI Orlando",
			url: Astro.site?.href,
			telephone: phone,
			email,
			address: {
				"@type": "PostalAddress",
				streetAddress: "7507 Kingspointe Pkwy STE 104",
				addressLocality: "Orlando",
				addressRegion: "FL",
				postalCode: "32819",
				addressCountry: "US",
			},
		},
		{
			"@type": "WebPage",
			"@id": pageURL,
			url: pageURL,
			name: title,
			alternateName: "A Heart for His House",
			description,
			inLanguage: "es",
			about: { "@id": `${Astro.site}#church` },
			publisher: { "@id": `${Astro.site}#church` },
		},
		{
			"@type": "FAQPage",
			mainEntity: uncorazonFaqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: { "@type": "Answer", text: faq.answer },
			})),
		},
	],
}
---

<Layout
	title={title}
	description={description}
	image={ogImage}
	navLogo="black">
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(structuredData)}
	/>
	<div class="uncorazon-page">
		<UnCorazonHero />
		<UnCorazonVision />
		<UnCorazonGoals />
		<UnCorazonFAQ />
		<UnCorazonParticipate />
		<a
			href="https://ppay.co/tAbXD6_Tunc"
			target="_blank"
			rel="noopener noreferrer"
			class="uncorazon-floating-cta"
			aria-label="Donar Ahora">
			Donar Ahora
		</a>
	</div>
</Layout>

<style is:global>
	html:has(.uncorazon-page) {
		scroll-behavior: smooth;
	}

	.uncorazon-floating-cta {
		position: fixed;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 50;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 2rem;
		background-color: var(--campaign-gold);
		color: var(--campaign-navy);
		font-family: "Bebas Neue", sans-serif;
		font-size: 1.15rem;
		letter-spacing: 0.12em;
		border-radius: 0.25rem;
		box-shadow:
			0 4px 20px rgba(252, 210, 42, 0.35),
			0 2px 8px rgba(0, 0, 0, 0.1);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease,
			background-color 0.25s ease;
		-webkit-tap-highlight-color: transparent;
	}

	.uncorazon-floating-cta:hover {
		transform: translateX(-50%) translateY(-4px);
		box-shadow:
			0 8px 32px rgba(252, 210, 42, 0.5),
			0 4px 12px rgba(0, 0, 0, 0.12);
		background-color: #fdd940;
	}

	.uncorazon-floating-cta:active {
		transform: translateX(-50%) translateY(0);
	}
</style>
